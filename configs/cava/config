; cava - tracked default, trimmed to the settings that matter.
; Machine-specific audio sinks do NOT belong here: set `source` locally if the
; auto-detected output is wrong (the RPi needed the HDMI sink, hardcoding that
; would mute cava on every other machine).
[general]
autosens = 1
overshoot = 0
sensitivity = 50
bar_width = 2
bar_spacing = 0
lower_cutoff_freq = 70
higher_cutoff_freq = 15000

[input]
method = pipewire
; source = alsa_output.platform-fef05700.hdmi.hdmi-stereo

[output]
channels = mono
mono_option = average
