 #if SIXEL_PATCH
 #include "sixel.h"
@@ -1841,11 +1843,120 @@ static int wlloadfont(Font *f, FcPattern *pattern, int type, int fontsize)
 	return 0;
 }
 
+#ifdef FONT_FACE
+/* Locate <FONT_FACE>-<style>.ttf in the usual font directories. */
+static char *
+wlfontpath(const char *style)
+{
+	static const char *home_dirs[] = { "/.local/share/fonts", "/.fonts",
+		"/Library/Fonts", NULL };
+	static const char *sys_dirs[] = { "/usr/share/fonts", "/usr/local/share/fonts",
+		"/usr/share/fonts/truetype", "/usr/share/fonts/TTF",
+		"/usr/share/fonts/opentype", NULL };
+	const char *home = getenv("HOME");
+	char path[PATH_MAX];
+	int i;
+
+	if (home) {
+		for (i = 0; home_dirs[i]; i++) {
+			snprintf(path, sizeof path, "%s%s/" FONT_FACE "-%s.ttf",
+					home, home_dirs[i], style);
+			if (access(path, R_OK) == 0)
+				return xstrdup(path);
+		}
+	}
+	for (i = 0; sys_dirs[i]; i++) {
+		snprintf(path, sizeof path, "%s/" FONT_FACE "-%s.ttf", sys_dirs[i], style);
+		if (access(path, R_OK) == 0)
+			return xstrdup(path);
+	}
+	return NULL;
+}
+
+/* Open one exact font file. The pattern carries only FC_FILE and FC_PIXEL_SIZE,
+ * which is all wld_font_open_pattern() reads: no font list, no family matching. */
+static int
+wlloadfontfile(Font *f, const char *path, int type, double px)
+{
+	FcPattern *pat = FcPatternCreate();
+	struct wld_extents extents;
+
+	if (!pat)
+		return 1;
+	FcPatternAddString(pat, FC_FILE, (const FcChar8 *)path);
+	FcPatternAddDouble(pat, FC_PIXEL_SIZE, px);
+	if (!(f->match = wld_font_open_pattern(wld.fontctx, pat, type, (int)px))) {
+		FcPatternDestroy(pat);
+		return 1;
+	}
+	FcPatternDestroy(pat);
+
+	/* keep a family pattern: only used to find a font for glyphs this face
+	 * does not have (emoji, other scripts) */
+	f->set = NULL;
+	f->pattern = FcNameParse((FcChar8 *)font);
+	if (f->pattern) {
+		FcPatternDel(f->pattern, FC_SIZE);
+		FcPatternAddDouble(f->pattern, FC_PIXEL_SIZE, px);
+	}
+
+	wld_font_text_extents(f->match, ascii_printable, &extents);
+	f->ascent = f->match->ascent;
+	f->descent = f->match->descent;
+	f->lbearing = 0;
+	f->rbearing = f->match->max_advance;
+	f->height = f->ascent + f->descent;
+	f->width = DIVCEIL(extents.advance, strlen(ascii_printable));
+	return 0;
+}
+
+/* Load regular/italic/bold/bold-italic straight from files. Returns 0 when the
+ * face is not installed, so the fontconfig path below can take over. */
+static int
+wlloadfontfiles(double fontsize)
+{
+	Font *fonts[] = { &dc.font, &dc.ifont, &dc.ibfont, &dc.bfont };
+	/* wld's fallback font slots: 0 regular, 1 italic, 2 bold, 3 bold-italic */
+	const int types[] = { 0, 1, 3, 2 };
+	char *paths[4];
+	double px = fontsize > 1 ? fontsize : DEFAULTFONTSIZE;
+	int i;
+
+	paths[0] = wlfontpath("Regular");
+	if (!paths[0])
+		return 0;
+	/* Nerd Font releases ship no italic cuts, so those fall back to upright */
+	paths[1] = wlfontpath("Italic");
+	paths[2] = wlfontpath("Bold");
+	paths[3] = wlfontpath("BoldItalic");
