diff --git a/patch/boxdraw_wl.c b/patch/boxdraw_wl.c
new file mode 100644
index 0000000..8fff47f
--- /dev/null
+++ b/patch/boxdraw_wl.c
@@ -0,0 +1,169 @@
+/*
+ * Copyright 2018 Avi Halachmi (:avih) avihpit@yahoo.com https://github.com/avih
+ * MIT/X Consortium License
+ *
+ * Wayland (wld) port of st's boxdraw patch.
+ *
+ * Upstream ships boxdraw.c, which draws through X11/Xft (XftDrawRect) and therefore
+ * cannot build in st-wl (X11/X.h redefines Glyph/Cursor/Font_, and the fork's Glyph
+ * has no .u member). The shape tables and the geometry logic are Avi's; only the
+ * rectangle primitive is replaced: wld_fill_rectangle on the wld renderer.
+ */
+
+/* Rounded non-negative integers division of n / d */
+#define BDIV(n, d) (((n) + (d) / 2) / (d))
+
+static void wldrawbox(int, int, int, int, uint32_t, uint32_t, ushort);
+static void wldrawboxlines(int, int, int, int, uint32_t, ushort);
+
+static void
+wlboxrect(uint32_t color, int x, int y, int w, int h)
+{
+	if (w > 0 && h > 0)
+		wld_fill_rectangle(wld.renderer, color | 0xff000000, x, y, w, h);
+}
+
+/* public API (declared in st.h) */
+
+int
+isboxdraw(Rune u)
+{
+	Rune block = u & ~0xff;
+	return (boxdraw && block == 0x2500 && boxdata[(uint8_t)u]) ||
+	       (boxdraw_braille && block == 0x2800);
+}
+
+/* the "index" is actually the entire shape data encoded as ushort */
+ushort
+boxdrawindex(const Glyph *g)
+{
+	if (boxdraw_braille && (g->u & ~0xff) == 0x2800)
+		return BRL | (uint8_t)g->u;
+	if (boxdraw_bold && (g->mode & ATTR_BOLD))
+		return BDB | boxdata[(uint8_t)g->u];
+	return boxdata[(uint8_t)g->u];
+}
+
+static void
+wldrawbox(int x, int y, int w, int h, uint32_t fg, uint32_t bg, ushort bd)
+{
+	ushort cat = bd & ~(BDB | 0xff);  /* mask out bold and data */
+	if (bd & (BDL | BDA)) {
+		/* lines (light/double/heavy/arcs) */
+		wldrawboxlines(x, y, w, h, fg, bd);
+
+	} else if (cat == BBD) {
+		/* lower (8-X)/8 block */
+		int d = BDIV((uint8_t)bd * h, 8);
+		wlboxrect(fg, x, y + d, w, h - d);
+
+	} else if (cat == BBU) {
+		/* upper X/8 block */
+		wlboxrect(fg, x, y, w, BDIV((uint8_t)bd * h, 8));
+
+	} else if (cat == BBL) {
+		/* left X/8 block */
+		wlboxrect(fg, x, y, BDIV((uint8_t)bd * w, 8), h);
+
+	} else if (cat == BBR) {
+		/* right (8-X)/8 block */
+		int d = BDIV((uint8_t)bd * w, 8);
+		wlboxrect(fg, x + d, y, w - d, h);
+
+	} else if (cat == BBQ) {
+		/* quadrants */
+		int w2 = BDIV(w, 2), h2 = BDIV(h, 2);
+		if (bd & TL)
+			wlboxrect(fg, x, y, w2, h2);
+		if (bd & TR)
+			wlboxrect(fg, x + w2, y, w - w2, h2);
+		if (bd & BL)
+			wlboxrect(fg, x, y + h2, w2, h - h2);
+		if (bd & BR)
+			wlboxrect(fg, x + w2, y + h2, w - w2, h - h2);
+
+	} else if (bd & BBS) {
+		/* shades: data is 1/2/3 for 25%/50%/75% alpha - blend fg into bg */
+		int d = (uint8_t)bd;
+		uint32_t r = ((((fg >> 16) & 0xff) * d + ((bg >> 16) & 0xff) * (4 - d)) / 4) & 0xff;
+		uint32_t g = ((((fg >>  8) & 0xff) * d + ((bg >>  8) & 0xff) * (4 - d)) / 4) & 0xff;
+		uint32_t b = ((( fg        & 0xff) * d + ( bg        & 0xff) * (4 - d)) / 4) & 0xff;
+		wlboxrect((r << 16) | (g << 8) | b, x, y, w, h);
+
+	} else if (cat == BRL) {
+		/* braille, each data bit is one dot of a 2x4 grid */
+		int w1 = BDIV(w, 2);
+		int h1 = BDIV(h, 4), h2 = BDIV(h, 2), h3 = BDIV(3 * h, 4);
+
+		if (bd & 1)   wlboxrect(fg, x,      y,      w1,     h1);
+		if (bd & 2)   wlboxrect(fg, x,      y + h1, w1,     h2 - h1);
+		if (bd & 4)   wlboxrect(fg, x,      y + h2, w1,     h3 - h2);
+		if (bd & 8)   wlboxrect(fg, x + w1, y,      w - w1, h1);
+		if (bd & 16)  wlboxrect(fg, x + w1, y + h1, w - w1, h2 - h1);
+		if (bd & 32)  wlboxrect(fg, x + w1, y + h2, w - w1, h3 - h2);
+		if (bd & 64)  wlboxrect(fg, x,      y + h3, w1,     h - h3);
+		if (bd & 128) wlboxrect(fg, x + w1, y + h3, w - w1, h - h3);
+	}
+}
+
+static void
+wldrawboxlines(int x, int y, int w, int h, uint32_t fg, ushort bd)
+{
+	/* s: stem thickness. width/8 roughly matches underscore thickness. */
+	/* We draw bold as 1.5 * normal-stem and at least 1px thicker.      */
+	/* doubles draw at least 3px, even when w or h < 3. bold needs 6px. */
+	int mwh = MIN(w, h);
+	int base_s = MAX(1, BDIV(mwh, 8));
+	int bold = (bd & BDB) && mwh >= 6;  /* possibly ignore boldness */
+	int s = bold ? MAX(base_s + 1, BDIV(3 * base_s, 2)) : base_s;
+	int w2 = BDIV(w - s, 2), h2 = BDIV(h - s, 2);
+	/* the s-by-s square (x + w2, y + h2, s, s) is the center texel.    */
+	/* The base length (per direction till edge) includes this square.  */
+
+	int light = bd & (LL | LU | LR | LD);
+	int double_ = bd & (DL | DU | DR | DD);
+
+	if (light) {
+		/* d: additional (negative) length to not-draw the center   */
+		/* texel - at arcs and avoid drawing inside (some) doubles  */
+		int arc = bd & BDA;
+		int multi_light = light & (light - 1);
+		int multi_double = double_ & (double_ - 1);
+		/* light crosses double only at DH+LV, DV+LH (ref. shapes)  */
+		int d = arc || (multi_double && !multi_light) ? -s : 0;
+
+		if (bd & LL)
+			wlboxrect(fg, x, y + h2, w2 + s + d, s);
+		if (bd & LU)
+			wlboxrect(fg, x + w2, y, s, h2 + s + d);
+		if (bd & LR)
+			wlboxrect(fg, x + w2 - d, y + h2, w - w2 + d, s);
+		if (bd & LD)
+			wlboxrect(fg, x + w2, y + h2 - d, s, h - h2 + d);
+	}
+
+	/* double lines - also align with light to form heavy when combined */
+	if (double_) {
+		int dl = bd & DL, du = bd & DU, dr = bd & DR, dd = bd & DD;
+		if (dl) {
+			int p = dd ? -s : 0, n = du ? -s : dd ? s : 0;
+			wlboxrect(fg, x, y + h2 + s, w2 + s + p, s);
+			wlboxrect(fg, x, y + h2 - s, w2 + s + n, s);
+		}
+		if (du) {
+			int p = dl ? -s : 0, n = dr ? -s : dl ? s : 0;
+			wlboxrect(fg, x + w2 - s, y, s, h2 + s + p);
+			wlboxrect(fg, x + w2 + s, y, s, h2 + s + n);
+		}
+		if (dr) {
+			int p = du ? -s : 0, n = dd ? -s : du ? s : 0;
+			wlboxrect(fg, x + w2 - p, y + h2 - s, w - w2 + p, s);
+			wlboxrect(fg, x + w2 - n, y + h2 + s, w - w2 + n, s);
+		}
+		if (dd) {
+			int p = dr ? -s : 0, n = dl ? -s : dr ? s : 0;
+			wlboxrect(fg, x + w2 + s, y + h2 - p, s, h - h2 + p);
+			wlboxrect(fg, x + w2 - s, y + h2 - n, s, h - h2 + n);
+		}
+	}
+}
