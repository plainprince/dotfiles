#!/bin/sh
# dwl session entry (Exec target of dwl.desktop, started by Ly).
# dwl's -s command does the rest: see dwl-autostart.
export PATH="$HOME/.local/bin:$PATH"
export WALLPAPER="${WALLPAPER:-$HOME/Pictures/Wallpapers/himalayan-mountains.png}"

# True when this machine is a QEMU/KVM guest. systemd answers directly when it
# is around, but Artix's inits do not ship systemd-detect-virt, so the fallbacks
# have to carry this on their own. Each one covers a case the others miss:
#
#   DMI      SMBIOS strings (QEMU/libvirt write "QEMU"/"KVM" into them) - x86,
#            and aarch64 when it boots through UEFI. Any id file, not just the
#            three that usually match.
#   fw_cfg   QEMU's firmware config device, /sys/firmware/qemu_fw_cfg - provided
#            by both the x86 and the aarch64 machine, so it is the one signal
#            that does not depend on firmware or ACPI.
#   DT       aarch64 guests booted from a device tree (no ACPI, so no DMI at
#            all) carry QEMU's "linux,dummy-virt" compatible string.
#   cpuinfo  TCG guests (no KVM) name QEMU's CPU model there.
#
# All sources are optional: a missing file or tool just means "not detected".
is_qemu_guest() {
	if command -v systemd-detect-virt >/dev/null 2>&1; then
		case "$(systemd-detect-virt 2>/dev/null)" in
		qemu | kvm) return 0 ;;
		esac
	fi
	if [ -d /sys/firmware/qemu_fw_cfg ]; then
		return 0
	fi
	if grep -rqi -e qemu -e kvm /sys/class/dmi/id 2>/dev/null; then
		return 0
	fi
	if grep -aqi -e dummy-virt -e qemu /proc/device-tree/compatible 2>/dev/null; then
		return 0
	fi
	if grep -qi -e 'QEMU Virtual CPU' /proc/cpuinfo 2>/dev/null; then
		return 0
	fi
	return 1
}

# QEMU's emulated cursor plane is buggy wherever it shows up (flicker, a frame
# of lag, or no pointer at all), so inside a guest wlroots draws the cursor in
# software instead. Only the default is filled in: an explicit setting,
# including =0, is left alone. (Upstream name is plural: WLR_NO_HARDWARE_CURSORS.)
if [ -z "${WLR_NO_HARDWARE_CURSORS:-}" ] && is_qemu_guest; then
	export WLR_NO_HARDWARE_CURSORS=1
fi

exec dwl -s "$HOME/.local/bin/dwl-autostart"
